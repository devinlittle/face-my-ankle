#!/sbin/openrc-run

name="achilles-api"
command="/usr/bin/achilles-api"

command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/achilles/stdout.log"
error_log="/var/log/achilles/stderr.log"

export HOST
export PORT
export DB_PATH
export LOG_DIR
export HASH_SECRET
export JWT_SECRET
export RUST_LOG

start_pre() {
  mkdir -p /var/log/achilles
}

depend() {
    after modules wpa_supplicant networkmanager dbus
}
