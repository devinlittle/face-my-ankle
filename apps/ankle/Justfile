[private]
default: help

# Shows this help message
help:
  @just --list

package-tar:
  #!/usr/bin/env bash
  cargo zigbuild --target aarch64-unknown-linux-musl --release -p ankle

  mkdir -p build/usr/bin
  mkdir -p build/etc/init.d
  mkdir -p build/etc/conf.d

  PROJECT_DIR="$(printf $(cd ../../ && pwd))"

  cp -v $PROJECT_DIR/target/aarch64-unknown-linux-musl/release/ankle build/usr/bin
  cp res/ankle.initd build/etc/init.d/ankle
  cp res/ankle.confd build/etc/conf.d/ankle
  chmod 755 build/etc/init.d/ankle
  chmod 755 build/usr/bin/ankle

  rm *.tar.zst
  tar -cvf - -C build . | zstd -T0 -o ankle.tar.zst
